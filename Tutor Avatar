/**
 * AI Avatar Controller — Real-time Web Audio Lip-Sync, Eye Blinking, Gaze & Gestures
 */

class AvatarController {
  constructor() {
    this.audioElement = document.getElementById("tutorAudio");
    this.mouthShape = document.getElementById("mouthShape");
    this.mouthTeeth = document.getElementById("mouthTeeth");
    this.leftEyelid = document.getElementById("leftEyelid");
    this.rightEyelid = document.getElementById("rightEyelid");
    this.leftEyeWhite = document.getElementById("leftEyeWhite");
    this.rightEyeWhite = document.getElementById("rightEyeWhite");
    this.leftPupil = document.getElementById("leftPupil");
    this.rightPupil = document.getElementById("rightPupil");
    this.leftBrow = document.getElementById("leftBrow");
    this.rightBrow = document.getElementById("rightBrow");
    this.avatarHead = document.getElementById("avatarHead");
    this.gestureArm = document.getElementById("gestureArm");
    this.soundWaveGlow = document.getElementById("soundWaveGlow");
    this.glassesGroup = document.getElementById("glassesGroup");
    this.emotionPill = document.getElementById("emotionPill");
    this.emotionText = document.getElementById("emotionText");
    this.tutorIcon = document.getElementById("tutorIcon");
    this.tutorNameDisplay = document.getElementById("tutorNameDisplay");
    this.tutorRoleDisplay = document.getElementById("tutorRoleDisplay");

    this.audioCtx = null;
    this.analyser = null;
    this.source = null;
    this.dataArray = null;
    this.isAudioConnected = false;

    this.isSpeaking = false;
    this.currentEmotion = "ready";
    this.currentGesture = "welcome";
    this.rafId = null;

    this.initAudioContext();
    this.startBlinkLoop();
    this.startSubtleIdleBreathing();
  }

  initAudioContext() {
    const resumeAndConnect = () => {
      if (this.isAudioConnected) return;
      try {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        this.audioCtx = new AudioContextClass();
        this.analyser = this.audioCtx.createAnalyser();
        this.analyser.fftSize = 256;
        this.analyser.smoothingTimeConstant = 0.65;
        this.dataArray = new Uint8Array(this.analyser.frequencyBinCount);

        this.source = this.audioCtx.createMediaElementSource(this.audioElement);
        this.source.connect(this.analyser);
        this.analyser.connect(this.audioCtx.destination);
        this.isAudioConnected = true;
      } catch (err) {
        console.warn("[Avatar AudioContext]", err);
      }
    };

    window.addEventListener("click", resumeAndConnect, { once: true });
    window.addEventListener("keydown", resumeAndConnect, { once: true });

    this.audioElement.addEventListener("play", () => {
      if (this.audioCtx && this.audioCtx.state === "suspended") {
        this.audioCtx.resume();
      }
      this.isSpeaking = true;
      if (this.soundWaveGlow) this.soundWaveGlow.classList.add("active");
      this.startLipSyncLoop();
    });

    this.audioElement.addEventListener("pause", () => this.stopSpeaking());
    this.audioElement.addEventListener("ended", () => this.stopSpeaking());
  }

  startLipSyncLoop() {
    const update = () => {
      if (!this.isSpeaking) {
        this.resetMouth();
        return;
      }

      let volume = 0;
      if (this.analyser && this.dataArray) {
        this.analyser.getByteFrequencyData(this.dataArray);
        let sum = 0;
        let count = 0;
        for (let i = 2; i < Math.min(26, this.dataArray.length); i++) {
          sum += this.dataArray[i];
          count++;
        }
        volume = sum / (count * 255);
      } else {
        volume = 0.3 + 0.35 * Math.sin(Date.now() / 80);
      }

      const mouthOpen = Math.min(22, volume * 38);
      const mouthWidth = 16 + Math.min(6, volume * 10);
      const topOffset = Math.min(8, volume * 12);

      const leftX = 200 - mouthWidth;
      const rightX = 200 + mouthWidth;
      const bottomY = 212 + mouthOpen;
      const topY = 212 - topOffset;

      this.mouthShape.setAttribute(
        "d",
        `M ${leftX} 212 Q 200 ${bottomY} ${rightX} 212 Q 200 ${topY} ${leftX} 212`
      );

      if (this.mouthTeeth) {
        this.mouthTeeth.setAttribute("opacity", volume > 0.3 ? "0.85" : "0");
      }

      if (this.soundWaveGlow) {
        const scale = 1 + volume * 0.3;
        this.soundWaveGlow.style.transform = `scale(${scale})`;
      }

      this.rafId = requestAnimationFrame(update);
    };

    if (this.rafId) cancelAnimationFrame(this.rafId);
    this.rafId = requestAnimationFrame(update);
  }

  stopSpeaking() {
    this.isSpeaking = false;
    if (this.soundWaveGlow) {
      this.soundWaveGlow.classList.remove("active");
      this.soundWaveGlow.style.transform = "scale(1)";
    }
    this.resetMouth();
  }

  resetMouth() {
    if (this.mouthShape) {
      this.mouthShape.setAttribute("d", "M 184 212 Q 200 216 216 212 Q 200 216 184 212");
    }
    if (this.mouthTeeth) {
      this.mouthTeeth.setAttribute("opacity", "0");
    }
  }

  startBlinkLoop() {
    const doBlink = () => {
      if (this.leftEyeWhite && this.rightEyeWhite) {
        this.leftEyeWhite.setAttribute("ry", "0.5");
        this.rightEyeWhite.setAttribute("ry", "0.5");
        this.leftPupil.setAttribute("opacity", "0");
        this.rightPupil.setAttribute("opacity", "0");
      }

      setTimeout(() => {
        if (this.leftEyeWhite && this.rightEyeWhite) {
          this.leftEyeWhite.setAttribute("ry", "8");
          this.rightEyeWhite.setAttribute("ry", "8");
          this.leftPupil.setAttribute("opacity", "1");
          this.rightPupil.setAttribute("opacity", "1");
        }
      }, 120);

      const nextDelay = 2800 + Math.random() * 2700;
      setTimeout(doBlink, nextDelay);
    };

    setTimeout(doBlink, 2000);
  }

  startSubtleIdleBreathing() {
    let t = 0;
    setInterval(() => {
      t += 0.04;
      if (!this.isSpeaking && this.avatarHead) {
        const tilt = Math.sin(t) * 1.5;
        const bob = Math.cos(t * 0.8) * 1.8;
        this.avatarHead.style.transform = `translateY(${bob}px) rotate(${tilt}deg)`;
      }
    }, 40);
  }

  setEmotion(emotion) {
    this.currentEmotion = emotion;
    if (this.emotionText) this.emotionText.textContent = emotion;

    switch (emotion) {
      case "explaining":
        this.leftBrow.setAttribute("d", "M 160 146 Q 175 140 188 145");
        this.rightBrow.setAttribute("d", "M 212 145 Q 225 140 240 146");
        this.lookAtBoard();
        break;

      case "encouraging":
        this.leftBrow.setAttribute("d", "M 160 143 Q 175 137 188 143");
        this.rightBrow.setAttribute("d", "M 212 143 Q 225 137 240 143");
        this.lookAtUser();
        this.avatarHead.style.transform = "rotate(2deg)";
        break;

      case "thinking":
        this.leftBrow.setAttribute("d", "M 160 144 Q 175 142 188 149");
        this.rightBrow.setAttribute("d", "M 212 138 Q 225 135 240 141");
        this.leftPupil.setAttribute("cx", "172");
        this.rightPupil.setAttribute("cx", "224");
        this.avatarHead.style.transform = "rotate(-4deg)";
        break;

      case "celebrating":
        this.leftBrow.setAttribute("d", "M 160 141 Q 175 134 188 141");
        this.rightBrow.setAttribute("d", "M 212 141 Q 225 134 240 141");
        this.lookAtUser();
        this.avatarHead.style.transform = "translateY(-4px)";
        break;

      case "listening":
        this.leftBrow.setAttribute("d", "M 160 145 Q 175 142 188 147");
        this.rightBrow.setAttribute("d", "M 212 147 Q 225 142 240 145");
        this.lookAtUser();
        this.avatarHead.style.transform = "rotate(3deg) translateY(2px)";
        break;

      default:
        this.lookAtUser();
        break;
    }
  }

  setGesture(gesture) {
    this.currentGesture = gesture;
    if (!this.gestureArm) return;

    this.gestureArm.classList.remove("point-board", "welcome", "ponder");

    if (gesture === "point_board") {
      this.gestureArm.classList.add("point-board");
      this.lookAtBoard();
    } else if (gesture === "welcome") {
      this.gestureArm.classList.add("welcome");
      this.lookAtUser();
    } else if (gesture === "ponder") {
      this.gestureArm.classList.add("ponder");
    } else {
      this.lookAtUser();
    }
  }

  lookAtBoard() {
    if (this.leftPupil && this.rightPupil) {
      this.leftPupil.setAttribute("cx", "180");
      this.rightPupil.setAttribute("cx", "232");
    }
  }

  lookAtUser() {
    if (this.leftPupil && this.rightPupil) {
      this.leftPupil.setAttribute("cx", "176");
      this.rightPupil.setAttribute("cx", "228");
    }
  }

  setPersona(personaKey) {
    if (personaKey === "aparna") {
      this.tutorIcon.textContent = "👩‍🏫";
      this.tutorNameDisplay.textContent = "Prof. Aparna";
      this.tutorRoleDisplay.textContent = "Lead EdTech Mentor";
      if (this.glassesGroup) this.glassesGroup.classList.remove("hidden");
    } else if (personaKey === "kabir") {
      this.tutorIcon.textContent = "👨‍🔬";
      this.tutorNameDisplay.textContent = "Dr. Kabir";
      this.tutorRoleDisplay.textContent = "Concept & Intuition Guide";
      if (this.glassesGroup) this.glassesGroup.classList.add("hidden");
    } else {
      this.tutorIcon.textContent = "⚡";
      this.tutorNameDisplay.textContent = "Simran";
      this.tutorRoleDisplay.textContent = "Interactive STEM Coach";
      if (this.glassesGroup) this.glassesGroup.classList.add("hidden");
    }
  }
}

window.AvatarController = AvatarController;
